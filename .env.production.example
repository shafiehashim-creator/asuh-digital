# Production .env template for asuh.galeriilmu.com.my
#
# Copy to /home/galeriil78/asuh-app/shared/.env on the server and fill in the
# blanks THERE. Never commit the real file. APP_KEY is generated automatically
# on the first deploy if left empty.

APP_NAME="ASUH Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://asuh.galeriilmu.com.my
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# cPanel > MySQL Databases (cPanel prefixes names with "galeriil78_")
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=galeriil78_asuh
DB_USERNAME=galeriil78_asuh
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# cPanel > Email Accounts > noreply@galeriilmu.com.my > Connect Devices
# (use the "Secure SSL/TLS" settings shown there)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=noreply@galeriilmu.com.my
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@galeriilmu.com.my"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# CHIP (portal.chip-in.asia > Developers). Start with TEST keys and
# CHIP_TEST_MODE=true; switch both to live only at launch.
CHIP_TEST_MODE=true
CHIP_BRAND_ID=
CHIP_API_KEY=
CHIP_WEBHOOK_PUBLIC_KEY=
